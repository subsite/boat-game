{
  "name": "boat-game",
  "version": "0.1.0",
  "private": true,
  "license": "GPL-3.0-or-later",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "cap:sync": "npm run build && cap sync",
    "cap:icons": "cp -r resources/android/res/. android/app/src/main/res/",
    "cap:android": "npm run cap:sync && npm run cap:icons && cap open android",
    "cap:ios": "npm run cap:sync && cap open ios",
    "release": "scripts/release.sh"
  },
  "dependencies": {
    "@capacitor/android": "^7.0.0",
    "@capacitor/core": "^7.0.0",
    "@capacitor/ios": "^7.0.0",
    "phaser": "^3.88.2"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.0.0",
    "typescript": "^5.8.3",
    "vite": "^6.3.5"
  }
}
